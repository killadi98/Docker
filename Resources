# limits and reservations should be set for the containers to avoid OOM issues.
  
flight:
    container_name: flight-cont
    build: ./flight/
    ports:
      - "1113:80"
    networks:
      - network3
    volumes:
      - volume3:/flight-vol/
    deploy:
      resources:
        reservations:
          cpus: "0.5"
          memory: 100M
        limits:
          cpus: "1.0"
          memory: 200M

